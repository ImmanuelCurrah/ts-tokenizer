{
  "name": "ts-tokenizer",
  "version": "0.0.1",
  "description": "tokenizer using bpe training to encode input text",
  "homepage": "https://github.com/ImmanuelCurrah/ts-tokenizer#readme",
  "bugs": {
    "url": "https://github.com/ImmanuelCurrah/ts-tokenizer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImmanuelCurrah/ts-tokenizer.git"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "tsx --test",
    "test-ascii": "tsx --test --test-name-pattern='round-trips ASCII text after training' src/lib/tokenizer/tokenizer.test.ts"
  },
  "dependencies": {
    "fast-check": "^4.10.2",
    "tsc": "^2.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
